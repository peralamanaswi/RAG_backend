GROQ_API_KEY=your_groq_api_key_here

# Optional: use Chroma Cloud on Render.
# If CHROMA_API_KEY is not set, the backend uses local ./chroma_db.
CHROMA_API_KEY=your_chroma_cloud_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=your_chroma_database_name_here

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=legal-document-explainer-backend
